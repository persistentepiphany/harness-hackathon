[
    {
        "id": "boltz2",
        "name": "Boltz-2",
        "version": "2.2.1",
        "role": "Executor and affinity",
        "outputs": [
            {
                "key": "confidence_score",
                "label": "Confidence score",
                "kind": "confidence",
                "scope": "global",
                "higherIsBetter": true,
                "note": "0.8 x complex_plddt + 0.2 x iptm, ptm for single chains (docs/prediction.md:201); models ranked by it"
            },
            {
                "key": "ptm",
                "label": "pTM",
                "kind": "confidence",
                "scope": "global",
                "higherIsBetter": true
            },
            {
                "key": "iptm",
                "label": "ipTM",
                "kind": "interface",
                "scope": "interface",
                "higherIsBetter": true
            },
            {
                "key": "ligand_iptm",
                "label": "Ligand ipTM",
                "kind": "interface",
                "scope": "ligand",
                "higherIsBetter": true
            },
            {
                "key": "protein_iptm",
                "label": "Protein ipTM",
                "kind": "interface",
                "scope": "interface",
                "higherIsBetter": true
            },
            {
                "key": "chains_ptm",
                "label": "Chain pTM",
                "kind": "confidence",
                "scope": "global",
                "higherIsBetter": true,
                "note": "per chain {chain index: value} (writer.py:190-212); parsed as chains_ptm.<index>"
            },
            {
                "key": "complex_plddt",
                "label": "Complex pLDDT",
                "kind": "plddt",
                "scope": "global",
                "range": [
                    0.0,
                    1.0
                ],
                "higherIsBetter": true,
                "note": "0-1 scale; Protenix, AF3 and ColabFold report 0-100"
            },
            {
                "key": "complex_iplddt",
                "label": "Interface pLDDT",
                "kind": "plddt",
                "scope": "interface",
                "higherIsBetter": true
            },
            {
                "key": "complex_pde",
                "label": "Complex PDE",
                "unit": "\u00c5",
                "kind": "pae",
                "scope": "global",
                "higherIsBetter": false,
                "note": "predicted distance error"
            },
            {
                "key": "complex_ipde",
                "label": "Interface PDE",
                "unit": "\u00c5",
                "kind": "pae",
                "scope": "interface",
                "higherIsBetter": false,
                "note": "predicted distance error"
            },
            {
                "key": "plddt",
                "label": "Per-token pLDDT",
                "kind": "plddt",
                "scope": "residue",
                "higherIsBetter": true,
                "note": "plddt_<name>_model_<k>.npz, key plddt, shape [N_tokens]"
            },
            {
                "key": "pae",
                "label": "PAE matrix",
                "kind": "pae",
                "scope": "residue",
                "higherIsBetter": false,
                "note": "pae_<name>_model_<k>.npz, only with --write_full_pae; unit not stated in writer.py (UNVERIFIED)"
            },
            {
                "key": "affinity_pred_value",
                "label": "Boltz-2 affinity",
                "unit": "log10(\u00b5M)",
                "kind": "affinity",
                "scope": "ligand",
                "higherIsBetter": false,
                "rankingOnly": true,
                "note": "log10(IC50 in \u00b5M); lower is a stronger binder; kcal/mol = (6 - y) x 1.364 (docs/prediction.md:249); only with properties.affinity"
            },
            {
                "key": "affinity_probability_binary",
                "label": "Binder probability",
                "kind": "affinity",
                "scope": "ligand",
                "range": [
                    0.0,
                    1.0
                ],
                "higherIsBetter": true,
                "rankingOnly": true,
                "note": "only with properties.affinity"
            }
        ],
        "family": "co-folding",
        "available": false,
        "note": "not installed on this host: boltz not in /home/user/harness-hackathon/.tools/executors/boltz2/bin or on PATH (pah runtimes install boltz2)",
        "licence": "MIT",
        "repo": "https://github.com/jwohlwend/boltz",
        "mvp": true,
        "runtime": {
            "profiles": [
                "csf3",
                "local",
                "modal"
            ],
            "accel": true,
            "gpu": "required",
            "accelConfigs": [
                "a100",
                "h100",
                "h200"
            ],
            "nativeVersion": "2.2.1",
            "verified": [
                "pins",
                "reachable"
            ]
        }
    },
