{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "A file used or produced by a run. Paths inside the run directory are relative to it.",
      "properties": {
        "derived_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind",
        "sha256",
        "size_bytes"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "input_structure",
        "input_ligand",
        "input_msa",
        "source_structure",
        "prediction_structure",
        "render",
        "session",
        "figure",
        "data",
        "graph",
        "report"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "EvidenceLevel": {
      "description": "Strength of the evidence behind a threshold or failure mode.",
      "enum": [
        "reproduced",
        "published",
        "suspected",
        "uncalibrated"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "Result of one check, with the values and thresholds that produced the gate.",
      "properties": {
        "artifacts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "gate": {
          "$ref": "#/$defs/Gate"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "measurements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "thresholds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Threshold"
          },
          "title": "Thresholds",
          "type": "array"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "check_id",
        "layer",
        "gate",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Gate": {
      "description": "Outcome of a single check.",
      "enum": [
        "pass",
        "warn",
        "stop",
        "skip"
      ],
      "title": "Gate",
      "type": "string"
    },
    "Layer": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5
      ],
      "title": "Layer",
      "type": "integer"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "pass",
        "pass_with_warnings",
        "stop",
        "incomplete"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a payload came from, down to the exact bytes.",
      "properties": {
        "accession": {
          "title": "Accession",
          "type": "string"
        },
        "extra": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Extra",
          "type": "object"
        },
        "release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Release"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "accession",
        "url",
        "sha256",
        "size_bytes"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Threshold": {
      "additionalProperties": false,
      "properties": {
        "comparator": {
          "description": "One of <, <=, >, >=, ==, !=, in",
          "title": "Comparator",
          "type": "string"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "uncalibrated"
        },
        "measurement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name of the measurement compared with this threshold, when it differs from the threshold name",
          "title": "Measurement"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "description": "Citation or calibration run the value comes from",
          "title": "Origin",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "comparator",
        "origin"
      ],
      "title": "Threshold",
      "type": "object"
    },
    "ToolRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolRef",
      "type": "object"
    },
    "Verdict": {
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "incomplete": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Incomplete",
          "type": "array"
        },
        "not_applicable": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Not Applicable",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "stops": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stops",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "scope",
        "outcome"
      ],
      "title": "Verdict",
      "type": "object"
    }
  },
  "$id": "https://github.com/persistentepiphany/harness-hackathon/schemas/run_record.json",
  "description": "Machine-readable record every report is generated from.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "claim": {
      "title": "Claim",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "layers": {
      "items": {
        "type": "integer"
      },
      "title": "Layers",
      "type": "array"
    },
    "manifest": {
      "additionalProperties": true,
      "title": "Manifest",
      "type": "object"
    },
    "pah_version": {
      "default": "0.1.0",
      "title": "Pah Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "task": {
      "title": "Task",
      "type": "string"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    },
    "usage": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "check id -> provenance ids it read",
      "title": "Usage",
      "type": "object"
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/Verdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "task",
    "claim",
    "layers",
    "manifest"
  ],
  "title": "RunRecord",
  "type": "object"
}
