{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "A file used or produced by a run. Paths inside the run directory are relative to it.",
      "properties": {
        "derived_from": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Derived From",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "kind",
        "sha256",
        "size_bytes"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "input_structure",
        "input_ligand",
        "input_msa",
        "source_structure",
        "prediction_structure",
        "render",
        "session",
        "figure",
        "data",
        "graph",
        "report"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "EvidenceLevel": {
      "description": "Strength of the evidence behind a threshold or failure mode.",
      "enum": [
        "reproduced",
        "published",
        "suspected",
        "uncalibrated"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "FigureEntry": {
      "properties": {
        "alt": {
          "title": "Alt",
          "type": "string"
        },
        "caption": {
          "title": "Caption",
          "type": "string"
        },
        "data_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Path"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "figure | render",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "session_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Path"
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "caption",
        "alt"
      ],
      "title": "FigureEntry",
      "type": "object"
    },
    "FindingRow": {
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration S"
        },
        "gate": {
          "title": "Gate",
          "type": "string"
        },
        "layer": {
          "title": "Layer",
          "type": "integer"
        },
        "measurements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "skip_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skip Reason"
        },
        "sources_used": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sources Used",
          "type": "array"
        },
        "thresholds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Threshold"
          },
          "title": "Thresholds",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "check_id",
        "title",
        "layer",
        "gate",
        "message"
      ],
      "title": "FindingRow",
      "type": "object"
    },
    "InputSummary": {
      "properties": {
        "ligands": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Ligands",
          "type": "array"
        },
        "model": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "proteins": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Proteins",
          "type": "array"
        },
        "receptor": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Receptor"
        }
      },
      "title": "InputSummary",
      "type": "object"
    },
    "LayerSection": {
      "properties": {
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/FindingRow"
          },
          "title": "Findings",
          "type": "array"
        },
        "layer": {
          "title": "Layer",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "name",
        "counts",
        "findings"
      ],
      "title": "LayerSection",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "pass",
        "pass_with_warnings",
        "stop",
        "incomplete"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "ProvenanceRow": {
      "properties": {
        "accession": {
          "title": "Accession",
          "type": "string"
        },
        "cache": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Release"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "used_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Used By",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "accession",
        "release",
        "retrieved_at",
        "size_bytes",
        "sha256",
        "url",
        "cache"
      ],
      "title": "ProvenanceRow",
      "type": "object"
    },
    "Threshold": {
      "additionalProperties": false,
      "properties": {
        "comparator": {
          "description": "One of <, <=, >, >=, ==, !=, in",
          "title": "Comparator",
          "type": "string"
        },
        "evidence_level": {
          "$ref": "#/$defs/EvidenceLevel",
          "default": "uncalibrated"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "description": "Citation or calibration run the value comes from",
          "title": "Origin",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "comparator",
        "origin"
      ],
      "title": "Threshold",
      "type": "object"
    },
    "ToolRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolRef",
      "type": "object"
    },
    "Verdict": {
      "properties": {
        "claim": {
          "title": "Claim",
          "type": "string"
        },
        "incomplete": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Incomplete",
          "type": "array"
        },
        "not_applicable": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Not Applicable",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "stops": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stops",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "claim",
        "scope",
        "outcome"
      ],
      "title": "Verdict",
      "type": "object"
    }
  },
  "$id": "https://github.com/persistentepiphany/harness-hackathon/schemas/run_report.json",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "claim": {
      "title": "Claim",
      "type": "string"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "figures": {
      "items": {
        "$ref": "#/$defs/FigureEntry"
      },
      "title": "Figures",
      "type": "array"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "graph": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Graph",
      "type": "object"
    },
    "inputs": {
      "$ref": "#/$defs/InputSummary"
    },
    "layers": {
      "items": {
        "type": "integer"
      },
      "title": "Layers",
      "type": "array"
    },
    "layers_not_run": {
      "items": {
        "type": "integer"
      },
      "title": "Layers Not Run",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "pah_version": {
      "title": "Pah Version",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/ProvenanceRow"
      },
      "title": "Provenance",
      "type": "array"
    },
    "render_errors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Render Errors",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/LayerSection"
      },
      "title": "Sections",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "task": {
      "title": "Task",
      "type": "string"
    },
    "task_title": {
      "title": "Task Title",
      "type": "string"
    },
    "tool_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Tool Versions",
      "type": "object"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "run_id",
    "task",
    "task_title",
    "claim",
    "layers",
    "layers_not_run",
    "started_at",
    "finished_at",
    "pah_version",
    "verdict",
    "counts",
    "inputs",
    "sections",
    "provenance",
    "tool_versions",
    "artifacts",
    "figures",
    "graph",
    "limitations"
  ],
  "title": "RunReport",
  "type": "object"
}
