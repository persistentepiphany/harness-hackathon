    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "seq": {
      "title": "Seq",
      "type": "integer"
    },
    "stage": {
      "title": "Stage",
