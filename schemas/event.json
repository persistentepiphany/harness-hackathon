        "stage_start",
        "progress",
        "result",
        "finding",
        "artifact",
        "stage_end",
        "run_end",
        "log"
      ],
      "title": "EventKind",
      "type": "string"
    }
  },
  "$id": "https://github.com/persistentepiphany/harness-hackathon/schemas/event.json",
